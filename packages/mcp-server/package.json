{
  "name": "@10iii/air-mcp-server",
  "version": "0.2.2",
  "mcpName": "io.github.10iii/air",
  "description": "MCP server for AIR - AI-optimized tool output compression",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/10iii/air.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://github.com/10iii/air#readme",
  "bugs": {
    "url": "https://github.com/10iii/air/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "mcp",
    "model-context-protocol",
    "claude",
    "compression",
    "ai-tools"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "air-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@10iii/air-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsup": "^8.0.0",
    "typescript": "^5.7.3"
  }
}
